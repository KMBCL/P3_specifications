@startuml overall
title Overall Diagram

left to right direction

class User {
    pk : uuid
    role : enum
    username : str
    first_name : str
    last_name : str
    password_hash : str
    email : str
}

class Student {}

class Tutor {}

User <|-- Student
User <|-- Tutor

class TutorAssignment{
    pk : uuid
    tutor_pk : uuid
    student_pk : uuid
    start_at : datetime
    end_at : datetime
}

Tutor -- TutorAssignment
Student -- TutorAssignment

class Appointment {
    pk : uuid
    title : str
    start_at : datetime
    end_at : datetime
}

class UserAppointment {
    pk : uuid
    appointment_pk : uuid
    user_pk : uuid
}

User -- UserAppointment
Appointment --  UserAppointment

class Message {
    pk : uuid
    from_user_pk : uuid
    to_user_pk : uuid
    sent_at:datetime
    read_at:datetime
    content : str
    pinned : bool
}

User -- Message
User -- Message

class Task {
    pk : uuid
    user_pk : uuid
    assigned_by_pk : uuid
    appointment_pk : uuid | None
    created_at : timestamp
    title : str
    completed : bool
}



Student -- Task 
Student -- Task
Tutor -- Task
Tutor -- Task

Appointment -- Task

@enduml