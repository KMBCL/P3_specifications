@startuml authentication
title Authentification

actor "Visiteur" as visitor
!include /specifications/docs/diagrams/actors/common.puml

student --|> user
tutor --|> user

usecase "M'inscrire" as register
usecase "Me connecter \n à mon espace personnel " as login
usecase "Me déconnecter \n de mon espace personnel" as logout
usecase "Réinitialiser \n mon mot de passe" as reset_password

visitor -- register
user -- login
user -- logout
user -- reset_password

@endumld